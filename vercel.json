{
  "version": 2,
  "functions": {
    "api/main.py": {
      "runtime": "vercel-python"
    }
  },
  "rewrites": [
    {
      "source": "/process-text",
      "destination": "/api/main.py"
    },
    {
      "source": "/deep-dive",
      "destination": "/api/main.py"
    },
    {
      "source": "/define-word",
      "destination": "/api/main.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/main.py"
    },
    {
      "source": "/(.*)",
      "destination": "/lexiRead/$1"
    }
  ]
}